    {
      "name": "PatrimoinePro (données réelles)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/PatrimoinePro.pyw",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
